@using Rts.Common
@using TaskManagementApplication.Views.Steps
@model TaskManagementApplication.Views.Steps.DynamicFormViewModel

<form asp-action="Review" method="post">
    @Html.HiddenFor(m => m.StepId)
    @Html.HiddenFor(m => m.OriginModelSeriallized)

    <div class="modal-header">
        <h5 class="modal-title">Review Step Requirements</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="row">
            @{

                var halfIndex = Model.Fields.Count / 2;
            }
            <div class="col-12 col-md-6">
                @for (var i = 0; i <= halfIndex; i++)
                {
                    var field = Model.Fields[i];

                    <div class="mb-6">
                        <label class="form-label">@field.Label</label>

                        @switch (field.Type)
                        {
                            case FieldType.Int:
                            case FieldType.Short:
                            case FieldType.Long:
                                <input type="number" name="@field.Name" value="@field.Value" class="form-control" />
                                break;

                            case FieldType.Decimal:
                                <input type="number" step="0.01" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.String:
                                <input type="text" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Guid:
                                <input type="text" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Boolean:
                                <div class="form-check">
                                    <input type="checkbox" name="@field.Name" class="form-check-input" disabled="@field.IsDiasabledOnView"
                                           @(field.Value is bool b && b ? "checked" : "") />
                                    <label class="form-check-label">@field.Label</label>
                                </div>
                                break;

                            case FieldType.DateTime:
                                // Cast the value to DateTime and format it correctly for the input.
                                var dateTimeValue = field.Value is DateTime dt
                                ? dt.ToString("yyyy-MM-ddTHH:mm")
                                : "";
                                <input type="datetime-local" name="@field.Name" value="@dateTimeValue" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Dropdown:
                                @if (field.IsDiasabledOnView)
                                {
                                    <select name="@field.Name" class="form-select" disabled="@field.IsDiasabledOnView">
                                        @foreach (var option in field.Options ?? new List<string>())
                                        {
                                            <option value="@option" selected="@(option == (field.Value?.ToString() ?? ""))">@option</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select name="@field.Name" class="form-select" disabled="@field.IsDiasabledOnView">
                                        @foreach (var valueItem in (string[])field.Value!)
                                        {
                                            @if (valueItem == "EveryOne")
                                            {
                                                <option value="@valueItem" selected="true">@valueItem</option>
                                            }
                                            else
                                            {
                                                <option value="@valueItem">@valueItem</option>

                                            }
                                        }
                                    </select>
                                }
                                break;

                            case FieldType.CheckBoxListAll:
                                var stringValueItems = (string[])field.Value!;
                                @for (int j = 0; j < stringValueItems.Length; j++)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedItems"
                                               value="@stringValueItems[j]"
                                               id="checkbox_@j"
                                               checked
                                               disabled="@field.IsDiasabledOnView" />
                                        <label class="form-check-label" for="checkbox_@j">
                                            @stringValueItems[j]
                                        </label>
                                    </div>
                                }
                                break;

                            case FieldType.CheckBoxListMany:
                                var stringValuePairs = (TypeCheckPair<object>[])field.Value!;
                                @for (int k = 0; k < stringValuePairs.Length; k++)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedItems"
                                               value="@stringValuePairs[k].Value"
                                               id="checkbox_@k"
                                               checked="@stringValuePairs[k].IsChecked"
                                               disabled="@field.IsDiasabledOnView" />
                                        <label class="form-check-label" for="checkbox_@k">
                                            @stringValuePairs[k].Value
                                        </label>
                                    </div>
                                }
                                break;
                        }
                    </div>
                }
            </div>
            <div class="col-12 col-md-6">
                @for (var i = halfIndex + 1; i <= Model.Fields.Count - 1; i++)
                {
                    var field = Model.Fields[i];

                    <div class="mb-6">
                        <label class="form-label">@field.Label</label>

                        @switch (field.Type)
                        {
                            case FieldType.Int:
                            case FieldType.Short:
                            case FieldType.Long:
                                <input type="number" name="@field.Name" value="@field.Value" class="form-control" />
                                break;

                            case FieldType.Decimal:
                                <input type="number" step="0.01" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.String:
                                <input type="text" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Guid:
                                <input type="text" name="@field.Name" value="@field.Value" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Boolean:
                                <div class="form-check">
                                    <input type="checkbox" name="@field.Name" class="form-check-input" disabled="@field.IsDiasabledOnView"
                                           @(field.Value is bool b && b ? "checked" : "") />
                                    <label class="form-check-label">@field.Label</label>
                                </div>
                                break;

                            case FieldType.DateTime:
                                // Cast the value to DateTime and format it correctly for the input.
                                var dateTimeValue = field.Value is DateTime dt
                                ? dt.ToString("yyyy-MM-ddTHH:mm")
                                : "";
                                <input type="datetime-local" name="@field.Name" value="@dateTimeValue" class="form-control" disabled="@field.IsDiasabledOnView" />
                                break;

                            case FieldType.Dropdown:
                                <select name="@field.Name" class="form-select" disabled="@field.IsDiasabledOnView">
                                    @{
                                        foreach (var option in field.Options ?? new List<string>())
                                        {
                                            <option value="@option" selected="@(option == (field.Value?.ToString() ?? ""))">@option</option>
                                        }
                                    }
                                </select>
                                break;

                            case FieldType.CheckBoxListAll:
                                var stringValueItems = (string[])field.Value!;
                                @for (int j = 0; j < stringValueItems.Length; j++)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedItems"
                                               value="@stringValueItems[j]"
                                               id="checkbox_@j"
                                               checked
                                               disabled="@field.IsDiasabledOnView" />
                                        <label class="form-check-label" for="checkbox_@j">
                                            @stringValueItems[j]
                                        </label>
                                    </div>
                                }
                                break;

                            case FieldType.CheckBoxListMany:
                                var stringValuePairs = (TypeCheckPair<object>[])field.Value!;
                                @for (int k = 0; k < stringValuePairs.Length; k++)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedItems"
                                               value="@stringValuePairs[k].Value"
                                               id="checkbox_@k"
                                               checked="@stringValuePairs[k].IsChecked"
                                               disabled="@field.IsDiasabledOnView" />
                                        <label class="form-check-label" for="checkbox_@k">
                                            @stringValuePairs[k].Value
                                        </label>
                                    </div>
                                }
                                break;
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save Requirements</button>
    </div>
</form>
